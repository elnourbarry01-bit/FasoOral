# ---- Base de données ----
POSTGRES_USER=faso_oral
POSTGRES_PASSWORD=changer_ce_mot_de_passe
POSTGRES_DB=faso_oral

# ---- API ----
NODE_ENV=production
JWT_SECRET=generer_une_chaine_aleatoire_de_64_caracteres_minimum
# Le frontend (Nginx) relaie /api vers l'API : même origine pour le site, l'API et les médias.
FRONTEND_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080

# ---- Compte administrateur initial (créé par npm run db:seed) ----
ADMIN_EMAIL=admin@exemple.bf
ADMIN_PASSWORD=choisir_un_mot_de_passe_robuste

# ---- Stockage : "local" ou "s3" ----
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=faso-oral-media
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=changer_ce_secret_minio
S3_FORCE_PATH_STYLE=true

# ---- E-mail (Mailpit en local, fournisseur SMTP réel en production) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FASO ORAL <no-reply@exemple.bf>"
